# Public base URL
PUBLIC_BASE_URL=https://your-public-domain.example.com

# AI Provider: "openai" (default) or "azure-openai"
OPENAI_API_PROVIDER=openai

# OpenAI (used when OPENAI_API_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
# Supported current Realtime models include gpt-realtime and gpt-realtime-2.
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_REASONING_EFFORT=medium
OPENAI_VOICE=shimmer

# Azure OpenAI (used when OPENAI_API_PROVIDER=azure-openai)
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Optional override for the exact realtime websocket endpoint if Azure gives you a
# dedicated realtime URL. Supports ws://, wss://, http://, or https:// values.
# AZURE_OPENAI_REALTIME_URL=wss://your-resource.openai.azure.com/openai/v1/realtime?model=your-realtime-deployment-name
# Optional. Use "v1" for the GA Azure realtime route or a preview version such as
# 2025-04-01-preview for the preview route. If omitted, the app uses v1 for
# non-preview deployment names and 2025-04-01-preview for deployment names that
# contain "preview".
# AZURE_OPENAI_REALTIME_API_VERSION=v1
# AZURE_OPENAI_REALTIME_DEPLOYMENT=your-realtime-deployment-name
# AZURE_OPENAI_CHAT_DEPLOYMENT=your-chat-deployment-name
# Optional. Reasoning-capable Azure chat deployments such as o4-mini require
# 2024-12-01-preview or later.
# AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview

# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_PREAMBLE_ENABLED=true
TWILIO_AI_DISCLOSURE_ENABLED=true
TWILIO_AI_DISCLOSURE_MESSAGE_FI=Huomioithan, etta puhut tekoalyavustajan kanssa.
TWILIO_AI_DISCLOSURE_MESSAGE_EN=Please note that you are speaking with an AI voice assistant.

# Assistant runtime
AGENT_LANGUAGE=en
AGENT_TEMPERATURE=0.6
# AGENT_OPENING_MESSAGE=Tervehdi soittajaa lyhyesti hänen kielellään, esittele itsesi Hotelli Framin digitaalisena puhelinavustajana ja kysy, miten voit auttaa.
TRANSCRIPTION_PROMPT=This is a live phone call. Transcribe faithfully, including hesitations when relevant. If a word is unclear, mark it clearly.

# Admin prompt UI
ADMIN_PROMPT_USERNAME=admin
ADMIN_PROMPT_PASSWORD=change_this_for_the_pilot

# Storage
APP_DATA_DIR=/data

# Optional path overrides. Leave commented to use APP_DATA_DIR defaults.
# PROMPT_STORE_PATH=/data/prompt_store.json
# CONVERSATION_LOG_DIR=/data
# DAILY_SUMMARY_HISTORY_PATH=/data/daily_summary_history.json
# FEEDBACK_SURVEY_HISTORY_PATH=/data/feedback_survey_history.json

# Notifications
CALLBACK_REQUEST_TO_PHONE=+358401234567
DAILY_SUMMARY_TO_PHONE=+358401234567

# BookingOnline (placeholder — non-resolvable by design; Phase 2 replaces this
# mechanism entirely with a synthetic backend, so these values are never meant
# to reach a real calendar)
BOOKINGONLINE_CALENDAR_BASE_URL=https://booking.hotelliframi.invalid/stable/integroitukalenteri.jsp
BOOKINGONLINE_TEEMA_ID=9101
BOOKINGONLINE_MYYJA_ID=9202

# Daily summary
DAILY_SUMMARY_TIMEZONE=Europe/Helsinki
DAILY_SUMMARY_AUTO_SEND_ENABLED=true
DAILY_SUMMARY_SEND_TIME=08:00

# Privacy and feedback
LOG_ANONYMIZATION_ENABLED=true
LOG_ANONYMIZER_MODEL=gpt-4o-mini
LOG_ANONYMIZER_TIMEOUT_SECONDS=20
LOG_ANONYMIZER_MAX_INPUT_CHARS=12000
FEEDBACK_SURVEY_ENABLED=true
FEEDBACK_SURVEY_MESSAGE_TEMPLATE=Kiitos soitostasi Hotelli Framin tekoalyavustajalle. Kuinka hyvin pystyimme auttamaan sinua? Vastaa numerolla 1-10, jossa 10 = erittain hyvin. Voit halutessasi kirjoittaa myos vapaamuotoisen palautteen.

# Diagnostics
SHOW_TIMING_MATH=false
VALIDATE_STARTUP_DEPENDENCIES=false
